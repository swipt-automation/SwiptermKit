+static struct archive *archive_read_tar_gz(void) {
+    struct archive *archive = archive_read_new();
+    if (archive != NULL) {
+        archive_read_support_filter_gzip(archive);
+        archive_read_support_format_tar(archive);
+    }
+    return archive;
+}
+
+bool fakefs_import(const char *archive_path, const char *fs, struct fakefsify_error *err_out, struct progress p) {
+    struct stat real_stat;
+    if (stat(archive_path, &real_stat) < 0)
+        POSIX_ERR();
+    struct archive *archive = archive_read_tar_gz();
+    if (archive == NULL)
+        ARCHIVE_ERR(archive);
+    if (archive_read_open_filename(archive, archive_path, 65536) != ARCHIVE_OK)
+        ARCHIVE_ERR(archive);
+    return import_archive(archive, real_stat.st_size, fs, err_out, p);
+}
+
+bool fakefs_import_memory(const void *data, size_t size, const char *fs, struct fakefsify_error *err_out, struct progress p) {
+    struct archive *archive = archive_read_tar_gz();
+    if (archive == NULL)
+        ARCHIVE_ERR(archive);
+    if (archive_read_open_memory(archive, data, size) != ARCHIVE_OK)
+        ARCHIVE_ERR(archive);
+    return import_archive(archive, size, fs, err_out, p);
+}
