diff --git a/src/kosmickrisp/bridge/mtl_device.m b/src/kosmickrisp/bridge/mtl_device.m
index b02191c5aea..d8c79d6d333 100644
--- a/src/kosmickrisp/bridge/mtl_device.m
+++ b/src/kosmickrisp/bridge/mtl_device.m
@@ -21,6 +21,16 @@
    mtl_device *device = nil;
 
    @autoreleasepool {
+#if TARGET_OS_IPHONE
+      /* iOS has a single GPU and MTLCopyAllDevices is only available from
+       * iOS 18. The Metal 4 classes the driver uses are weakly imported, so
+       * report no device on systems older than iOS 26. */
+      if (@available(iOS 26, *)) {
+         id<MTLDevice> dev = [MTLCreateSystemDefaultDevice() autorelease];
+         if ([dev supportsFamily:MTLGPUFamilyMetal4])
+            device = (mtl_device *)[dev retain];
+      }
+#else
       NSArray<id<MTLDevice>> *devs = [MTLCopyAllDevices() autorelease];
       uint32_t device_count = [devs count];
       
@@ -30,6 +40,7 @@
             break;
          }
       }
+#endif
    }
 
    return device;
