diff --git a/src/kosmickrisp/vulkan/kk_icd_ios.exp b/src/kosmickrisp/vulkan/kk_icd_ios.exp
new file mode 100644
index 00000000000..de0c6f88310
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_icd_ios.exp
@@ -0,0 +1,3 @@
+_vk_icdGetInstanceProcAddr
+_vk_icdGetPhysicalDeviceProcAddr
+_vk_icdNegotiateLoaderICDInterfaceVersion
diff --git a/src/kosmickrisp/vulkan/meson.build b/src/kosmickrisp/vulkan/meson.build
index 6f848f902c8..e6f7ff44452 100644
--- a/src/kosmickrisp/vulkan/meson.build
+++ b/src/kosmickrisp/vulkan/meson.build
@@ -172,12 +172,29 @@ libkk = static_library(
   gnu_symbol_visibility : 'hidden',
 )
 
-# Happens with macOS ld linker:
-# "-Wl,-undefined,dynamic_lookup" required, otherwise, linker will complain about undefined symbols
+kk_link_args = [ld_args_build_id]
+if host_machine.subsystem().startswith('ios')
+  # Built as KosmicKrisp.framework and dlopen'ed next to other Mesa-derived
+  # code, so only the ICD entrypoints are exported. Unimplemented entrypoints
+  # are weak references that Mach-O could only bind through the flat
+  # namespace at load time; SwiptermKit's build_vulkan defines them as absolute zero
+  # in kk_null_entrypoints.o instead.
+  kk_link_args += [
+    meson.current_build_dir() / 'kk_null_entrypoints.o',
+    '-Wl,-exported_symbols_list,' + (meson.current_source_dir() / 'kk_icd_ios.exp'),
+    '-Wl,-install_name,@rpath/KosmicKrisp.framework/KosmicKrisp',
+    '-Wl,-dead_strip',
+  ]
+else
+  # Happens with macOS ld linker:
+  # "-Wl,-undefined,dynamic_lookup" required, otherwise, linker will complain about undefined symbols
+  kk_link_args += '-Wl,-undefined,dynamic_lookup'
+endif
+
 libvulkan_kosmickrisp = shared_library(
   'vulkan_kosmickrisp',
   link_whole: [libkk],
-  link_args: [ld_args_build_id, '-Wl,-undefined,dynamic_lookup'],
+  link_args: kk_link_args,
   gnu_symbol_visibility : 'hidden',
   install : true,
 )
